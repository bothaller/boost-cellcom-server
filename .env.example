# monday code injects PORT at runtime; 8080 is the local default.
PORT=8080
NODE_ENV=development

# monday.com
MONDAY_API_TOKEN=your_monday_personal_or_app_token
MONDAY_API_URL=https://api.monday.com/v2
MONDAY_API_VERSION=2024-10
MONDAY_BOARD_ID=1234567890

# Shared secret the external API must send in the x-webhook-secret header
WEBHOOK_SECRET=AG^.b!UtYcpd*=MBw@9_

# Board column ids are not env config — see src/monday/columns.ts
